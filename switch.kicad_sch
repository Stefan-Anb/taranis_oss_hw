		(uuid "889d5cc5-590e-4d89-8615-653589c7b142")
	)
	(text_box "Pre-Discharge MOSFET\nUsing Charge MOSFET to block charging\nCurrent limit ca. 200mA - about 1 second charge time for a 3mF circuit\n\nPower is dissipated through PMOS Pv=12 Watt peak @deltaV=60V\nRthjc = 2.8K/W\ndeltaT = 33K\n\nIn reality less because of thermal impedance, but relevant for short circuit (pulse time about 1 second)"
		(exclude_from_sim no)
		(at 149.86 128.27 0)
		(size 46.99 27.94)
		(margins 0.9525 0.9525 0.9525 0.9525)
